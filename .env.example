# ---------------------------------------------------------------------------
# OLANG platform environment template
# Copy to .env and fill only the values you actually have.
# Never commit .env or real credentials.
# ---------------------------------------------------------------------------

NODE_ENV=development
HOST=127.0.0.1
PORT=4174

# Public canonical origin. No trailing slash.
SITE_URL=http://127.0.0.1:4174
SITE_NAME=OLANG

# demo = noindex review environment; production = public launch mode
# Indexing additionally requires an HTTPS SITE_URL and ALLOW_SEARCH_INDEXING=1
SITE_MODE=demo
ALLOW_SEARCH_INDEXING=1

# SQLite database and private attachments
DB_PATH=./storage/olang.sqlite
UPLOAD_DIR=./storage/uploads

# First administrator. If no users exist, the app creates this account.
# If ADMIN_INITIAL_PASSWORD is empty, a random password is written once to
# storage/bootstrap-admin.txt and printed in the server log.
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_EMAIL=
ADMIN_INITIAL_PASSWORD=

# Set to 1 when served over HTTPS. "auto" = secure in production.
SESSION_COOKIE_SECURE=auto
# Set to 1 only when a trusted reverse proxy terminates TLS.
TRUST_PROXY=0

# ---------------------------------------------------------------------------
# Email adapter
# transport=outbox  : store notification + acknowledgement in DB; status clearly
#                     reported as "not configured". Nothing is claimed as sent.
# transport=smtp    : send through the SMTP server below.
# ---------------------------------------------------------------------------
EMAIL_TRANSPORT=outbox
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
MAIL_FROM=OLANG Website <no-reply@example.invalid>
INQUIRY_NOTIFICATION_EMAIL=
# Reply-To for the customer acknowledgement
INQUIRY_REPLY_TO=

# Optional CRM adapter. Leave blank unless a real endpoint and credentials exist.
# The request is signed with HMAC-SHA256 using CRM_WEBHOOK_SECRET.
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=

# Optional language-model reply adapter (OpenAI-compatible chat completions).
# Leave disabled to run the grounded rule-based assistant. The API key is used
# only on the server and is never sent to the browser.
ASSISTANT_LLM_ENABLED=0
ASSISTANT_BASE_URL=
ASSISTANT_MODEL=
ASSISTANT_API_KEY=
ASSISTANT_TIMEOUT_MS=12000
ASSISTANT_MAX_TOKENS=500

# Consent / retention settings
COOKIE_POLICY_VERSION=2026-11-08
ANALYTICS_RETENTION_DAYS=400
INQUIRY_RETENTION_MONTHS=24
UPLOAD_RETENTION_MONTHS=12

# Upload limits (bytes)
MAX_UPLOAD_BYTES=10485760
MAX_UPLOAD_FILES=5

# Optional: only trust this many proxy hops for client IP / country headers.
PROXY_HOPS=0
