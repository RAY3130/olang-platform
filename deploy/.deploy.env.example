# =============================================================================
# 本项目部署参数（可选）
#
# 已配置用户级长期凭据：C:\Users\53688\.workbuddy\deploy\credentials.env
# 本文件可以完全留空 —— 脚本会自动回退到用户级凭据，今后所有项目共用一份。
# 只有需要覆盖全局默认值（如本项目改用私有仓库 / starter 计划）时才填写。
#
# 该文件已被 .gitignore 排除，不会提交到仓库。
# =============================================================================

# GitHub 个人访问令牌
#   地址：https://github.com/settings/tokens/new
#   classic 令牌勾选：repo（必需）、workflow（可选）
#   fine-grained 令牌需要：Contents = Read and write、Administration = Read and write
GH_TOKEN=

# Render API Key
#   地址：https://dashboard.render.com/u/settings#api-keys
#   点击 Create API Key，复制 rnd_ 开头的字符串
RENDER_API_KEY=

# ---------------------------- 以下可选，留空用默认值 ----------------------------

# GitHub 仓库名（默认 olang-platform）
REPO_NAME=olang-platform

# Render 服务名（默认 olang-platform，决定默认域名 <name>.onrender.com）
SERVICE_NAME=olang-platform

# 分支名
BRANCH=main

# GitHub 仓库可见性：public / private
#   建议 public：private 仓库需要 Render 的 GitHub App 额外授权，会多一步人工操作
REPO_VISIBILITY=public

# Render 计划：free / starter
#   free    —— 不绑卡、零成本；闲置 15 分钟休眠，首次访问约 30-60 秒；无持久磁盘，重新部署会重置数据
#   starter —— 约 $7/月，需绑定支付方式；不休眠，可挂 1GB 持久磁盘，数据不丢
RENDER_PLAN=free

# Render 区域：singapore / frankfurt / oregon / ohio / virginia
RENDER_REGION=singapore

# 后台管理员
ADMIN_USERNAME=admin
# 留空则自动生成 20 位随机密码，并保存到 deploy/.admin-credentials.local.txt
ADMIN_PASSWORD=
