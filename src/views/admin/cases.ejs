<div class="admin-toolbar">
  <div><p class="admin-kicker">Project content</p><h2>Project references</h2></div>
  <a class="btn btn-ghost btn-small" href="/admin/content">Back to content</a>
</div>
<div class="admin-note"><strong>Reference status:</strong> a company-published reference may be shown with its public source and clear label. A reference marked Verified requires written authorization and an authorization reference. Do not use a client logo without specific permission.</div>

<section class="admin-panel" style="margin-top:1rem">
  <h3>Create reference</h3>
  <form method="post" action="/admin/cases" class="admin-form">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <div class="admin-form-grid">
      <label>Title<input name="title" required maxlength="200"></label>
      <label>Slug<input name="slug" maxlength="120" placeholder="auto from title"></label>
      <label>Market / region<input name="market" maxlength="40"></label>
      <label>Location<input name="location" maxlength="200"></label>
      <label>Project type<input name="project_type" maxlength="100"></label>
      <label>Year<input name="year" maxlength="20"></label>
      <label>Products / scope<input name="products" maxlength="1000"></label>
      <label>Image path<input name="image_path" maxlength="300"></label>
      <label>Source URL<input name="source_url" maxlength="500"></label>
      <label>Verification status
        <select name="verification_status">
          <option value="company_published">Company-published reference</option>
          <option value="verified">Verified reference (authorization required)</option>
          <option value="pending">Pending verification</option>
        </select>
      </label>
      <label>Authorization reference<input name="authorization_reference" maxlength="300" placeholder="written approval / email date"></label>
      <label style="grid-column:1/-1">Summary — English<textarea name="summary" rows="4" maxlength="4000" required></textarea></label>
      <label style="grid-column:1/-1">Summary — Deutsch<textarea name="summary_de" rows="3" maxlength="4000"></textarea></label>
      <label style="grid-column:1/-1">Summary — Italiano<textarea name="summary_it" rows="3" maxlength="4000"></textarea></label>
      <label class="check"><input type="checkbox" name="authorization_confirmed" value="1"> Written authorization has been confirmed</label>
      <label class="check"><input type="checkbox" name="published" value="1"> Publish on the public site</label>
    </div>
    <button class="btn btn-primary btn-small" type="submit">Create reference</button>
  </form>
</section>

<% if (cases.length) { %>
<div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>Title</th><th>Status</th><th>Authorization</th><th>Published</th><th>Updated</th><th></th></tr></thead><tbody>
<% cases.forEach(function (entry) { %>
<tr>
  <td><strong><%= entry.title %></strong><small><%= entry.summary.slice(0, 110) %></small></td>
  <td><%= entry.verification_status || 'pending' %></td>
  <td><%= entry.authorization_reference || '—' %><small><%= entry.authorization_confirmed ? 'confirmed' : 'not confirmed' %></small></td>
  <td><span class="status-pill <%= entry.published ? 'status-won' : 'status-archived' %>"><%= entry.published ? 'Published' : 'Hidden' %></span></td>
  <td><%= entry.updated_at.slice(0,10) %></td>
  <td><a class="text-link" href="/admin/cases/<%= entry.id %>">Edit</a> · <form method="post" action="/admin/cases/<%= entry.id %>/toggle" class="admin-inline-form"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="link-button" type="submit"><%= entry.published ? 'Unpublish' : 'Publish' %></button></form></td>
</tr>
<% }); %>
</tbody></table></div>
<% } else { %><div class="admin-empty">No project references have been recorded.</div><% } %>
