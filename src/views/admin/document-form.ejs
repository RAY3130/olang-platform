<div class="admin-toolbar">
  <div><p class="admin-kicker">Document library</p><h2><%= document ? document.title : 'Add document' %></h2></div>
  <a class="btn btn-ghost btn-small" href="/admin/documents">Back to documents</a>
</div>
<p class="admin-form-note">Files are stored outside the public web root. Only a public + available record with a real file can be downloaded by a visitor. Version history is maintained by creating a new record and referencing the previous one.</p>

<form method="post" action="<%= document ? '/admin/documents/' + document.id : '/admin/documents/new' %>" enctype="multipart/form-data" class="admin-form">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <section class="admin-panel">
    <div class="admin-form-grid">
      <label>Title *<input name="title" value="<%= document ? document.title : '' %>" maxlength="300" required></label>
      <label>Document type<select name="doc_type"><% docTypes.forEach(function (type) { %><option value="<%= type %>"<%= document && document.doc_type === type ? ' selected' : '' %>><%= type %></option><% }); %></select></label>
      <label>Product<select name="product_id"><option value="">No specific product</option><% products.forEach(function (p) { %><option value="<%= p.id %>"<%= document && document.product_id === p.id ? ' selected' : '' %>><%= p.sku %> — <%= p.slug %></option><% }); %></select></label>
      <label>Category<select name="category_id"><option value="">No category</option><% categories.forEach(function (c) { %><option value="<%= c.id %>"<%= document && document.category_id === c.id ? ' selected' : '' %>><%= c.key %></option><% }); %></select></label>
      <label>Version<input name="version" value="<%= document ? document.version : '1.0' %>" maxlength="80"></label>
      <label>Language<select name="language"><option value="en"<%= !document || document.language === 'en' ? ' selected' : '' %>>English</option><option value="de"<%= document && document.language === 'de' ? ' selected' : '' %>>Deutsch</option><option value="it"<%= document && document.language === 'it' ? ' selected' : '' %>>Italiano</option></select></label>
      <label>Visibility<select name="visibility"><% visibilities.forEach(function (value) { %><option value="<%= value %>"<%= document && document.visibility === value ? ' selected' : '' %>><%= value %></option><% }); %></select></label>
      <label>Status<select name="status"><% statuses.forEach(function (value) { %><option value="<%= value %>"<%= document && document.status === value ? ' selected' : '' %>><%= value %></option><% }); %></select></label>
      <label>Effective date<input type="date" name="effective_date" value="<%= document && document.effective_date ? document.effective_date.slice(0,10) : '' %>"></label>
      <label>Supersedes document ID<input type="number" name="supersedes_id" min="1" value="<%= document && document.supersedes_id ? document.supersedes_id : '' %>"></label>
    </div>
    <div class="admin-field" style="margin-top:.8rem">
      <span>Markets</span>
      <div class="admin-form-grid">
        <% markets.forEach(function (marketCode) { %><label class="check"><input type="checkbox" name="markets" value="<%= marketCode %>"<%= selectedMarkets.includes(marketCode) ? ' checked' : '' %>><%= marketCode %></label><% }); %>
      </div>
    </div>
    <label class="full" style="margin-top:.8rem">Notes (internal)<textarea name="notes" rows="3" maxlength="3000"><%= document ? document.notes || '' : '' %></textarea></label>
  </section>

  <section class="admin-panel">
    <h3>File</h3>
    <% if (document && document.file_path) { %>
    <p>Current file: <strong><%= document.original_name %></strong> · <%= document.mime_type %> · <%= Math.round((document.size_bytes || 0) / 1024) %> KB · SHA-256 <span class="admin-code"><%= document.sha256 %></span></p>
    <a class="text-link" href="/admin/documents/<%= document.id %>/file">Download current file</a>
    <% } else { %><p class="admin-meta">No file stored for this record.</p><% } %>
    <label class="admin-field">Upload / replace file<input type="file" name="document" accept=".pdf,.png,.jpg,.jpeg,.stp,.step"></label>
    <p class="admin-form-note">Allowed: PDF, PNG, JPEG, STEP/STP. Maximum 15 MB. Type and signature are checked. This deployment does not run antivirus scanning; do not upload untrusted executables.</p>
  </section>

  <div class="admin-form-actions">
    <button class="btn btn-primary" type="submit">Save document</button>
    <a class="btn btn-ghost" href="/admin/documents">Cancel</a>
  </div>
</form>

<% if (document) { %>
<div class="admin-danger" style="margin-top:1.2rem">
  <h3>Withdraw document</h3>
  <p>Withdrawing removes the public download from service. The metadata record and file remain available to staff for audit.</p>
  <form method="post" action="/admin/documents/<%= document.id %>/withdraw" class="admin-inline-form" data-confirm="Withdraw this document from public access?">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <button class="btn btn-ghost btn-small" type="submit">Withdraw</button>
  </form>
</div>
<% } %>
