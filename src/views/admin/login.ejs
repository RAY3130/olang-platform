<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex,nofollow">
  <title>Staff sign-in | OLANG</title>
  <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/assets/main.css?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '1' %>">
  <link rel="stylesheet" href="/assets/admin.css?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '1' %>">
</head>
<body class="admin-login-body">
  <main class="admin-login">
    <div class="admin-login-brand">
      <span class="brand-ring" aria-hidden="true"></span>
      <span><strong>OLANG</strong><small>International platform · Staff portal</small></span>
    </div>
    <h1>Sign in</h1>
    <p class="small-note">Protected administration area. Sessions expire after 8 hours. Login attempts are rate-limited.</p>
    <% if (error) { %><div class="admin-flash admin-flash-error" role="alert"><%= error %></div><% } %>
    <form method="post" action="/admin/login" class="admin-form">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <input type="hidden" name="next" value="<%= next %>">
      <label>Username<input name="username" type="text" autocomplete="username" required maxlength="80" value="<%= username %>"></label>
      <label>Password<input name="password" type="password" autocomplete="current-password" required></label>
      <button class="btn btn-primary btn-full" type="submit">Sign in</button>
    </form>
    <p class="small-note admin-login-note">This portal is not linked to a production email or CRM service unless configured. Check the dashboard for service status.</p>
    <a class="text-link" href="/en">← Public website</a>
  </main>
</body>
</html>
