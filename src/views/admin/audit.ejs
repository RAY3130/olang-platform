<div class="admin-toolbar">
  <div><p class="admin-kicker">Traceability</p><h2>Audit log</h2></div>
  <a class="btn btn-ghost btn-small" href="/admin/users">Users</a>
</div>
<p class="admin-form-note">The audit log records administrative actions and security events. It does not store passwords or upload contents. Inquiry erasure keeps the action and reference, not the erased personal data.</p>
<div class="admin-table-wrap">
  <table class="admin-table">
    <thead><tr><th>Time (UTC)</th><th>Actor</th><th>Action</th><th>Entity</th><th>Meta</th></tr></thead>
    <tbody>
      <% rows.forEach(function (row) { %>
      <tr><td><%= row.created_at.slice(0,16).replace('T',' ') %></td><td><%= row.actor || 'System / failed login' %></td><td><%= row.action %></td><td><%= row.entity_type %><%= row.entity_id ? ' #' + row.entity_id : '' %></td><td><span class="admin-code"><%= row.meta_json || '' %></span></td></tr>
      <% }); %>
      <% if (!rows.length) { %><tr><td colspan="5">No audit entries.</td></tr><% } %>
    </tbody>
  </table>
</div>
