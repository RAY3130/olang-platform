<div class="admin-toolbar">
  <div><p class="admin-kicker">Editorial</p><h2>News and industry notes</h2></div>
  <a class="btn btn-ghost btn-small" href="/en/news" target="_blank" rel="noopener">View news page ↗</a>
</div>
<p class="admin-form-note">Articles are migrated from OLANG’s public news archive with source attribution. Keep the source URL and do not add product specifications that are not confirmed for the exact SKU.</p>

<div class="admin-table-wrap">
  <table class="admin-table">
    <thead><tr><th>Date</th><th>Category</th><th>Title</th><th>Published</th><th>Source</th><th></th></tr></thead>
    <tbody>
      <% articles.forEach(function (article) { %>
      <tr>
        <td><%= article.published_at %></td>
        <td><%= article.category %></td>
        <td><strong><%= article.title %></strong><small><%= (article.excerpt || '').slice(0, 100) %></small></td>
        <td><span class="status-pill <%= article.published ? 'status-won' : 'status-archived' %>"><%= article.published ? 'Published' : 'Hidden' %></span></td>
        <td><%= article.source_url ? 'Source linked' : '—' %></td>
        <td><a class="text-link" href="/admin/news/<%= article.id %>">Edit</a></td>
      </tr>
      <% }); %>
    </tbody>
  </table>
</div>
