<section class="admin-panel admin-narrow">
  <p class="admin-kicker">Account security</p>
  <h2>Change your password</h2>
  <p class="small-note">Use at least 12 characters with a letter and a number. Do not reuse another account password. Other sessions will be signed out.</p>
  <form method="post" action="/admin/password" class="admin-form">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <label>Current password<input type="password" name="current_password" autocomplete="current-password" required></label>
    <label>New password<input type="password" name="new_password" autocomplete="new-password" minlength="12" required></label>
    <label>Confirm new password<input type="password" name="confirm_password" autocomplete="new-password" minlength="12" required></label>
    <button class="btn btn-primary" type="submit">Update password</button>
  </form>
</section>
