<% function pct(value, max) { return max > 0 ? Math.max(2, Math.round((value / max) * 100)) : 0; } %>
<div class="admin-toolbar">
  <div>
    <p class="admin-kicker">Operations overview</p>
    <h2><%= canAnalytics ? 'Traffic, funnel and inquiry operations' : 'Content and knowledge operations' %></h2>
  </div>
  <div class="admin-actions">
    <a class="btn btn-ghost btn-small" href="/admin/products">Products</a>
    <% if (canInquiries) { %><a class="btn btn-ghost btn-small" href="/admin/inquiries">Inquiries</a><% } %>
    <a class="btn btn-primary btn-small" href="/admin/content">Edit content</a>
  </div>
</div>

<div class="admin-flash admin-flash-error">
  <strong>No production baseline exists in this database.</strong>
  Analytics starts when this deployment begins recording. Do not present percentage improvements as measured results. Date baseline: <%= baseline ? baseline.slice(0, 10) : 'not set' %>.
  <%= emailConfigured ? ' SMTP is configured.' : ' SMTP is NOT configured; inquiry emails are stored in the outbox as not_configured.' %>
</div>

<% if (canAnalytics && analytics) { %>
<div class="admin-actions" style="margin-bottom:.8rem">
  <% [['7','7 days'],['30','30 days'],['90','90 days'],['all','All time']].forEach(function (entry) { %>
  <a class="status-pill <%= analytics.days === entry[0] ? 'status-reviewing' : '' %>" href="/admin?days=<%= entry[0] %>"><%= entry[1] %></a>
  <% }); %>
  <a class="btn btn-ghost btn-small" href="/admin/analytics/export.csv">Export events CSV</a>
</div>
<div class="admin-kpis">
  <div class="admin-kpi"><span>Sessions</span><strong><%= analytics.kpis.sessions %></strong><small>consented analytics</small></div>
  <div class="admin-kpi"><span>Page views</span><strong><%= analytics.kpis.pageviews %></strong><small>consented analytics</small></div>
  <div class="admin-kpi"><span>Product views</span><strong><%= analytics.kpis.productViews %></strong><small>consented analytics</small></div>
  <div class="admin-kpi"><span>Inquiries</span><strong><%= analytics.kpis.totalInquiries %></strong><small>portal records</small></div>
  <div class="admin-kpi"><span>Conversion</span><strong><%= analytics.kpis.conversion == null ? '—' : analytics.kpis.conversion.toFixed(1) + '%' %></strong><small>inquiries / sessions*</small></div>
  <div class="admin-kpi"><span>Open</span><strong><%= analytics.kpis.openInquiries %></strong><small><%= analytics.kpis.newInquiries %> new</small></div>
  <div class="admin-kpi"><span>Document requests</span><strong><%= analytics.kpis.documentRequests %></strong><small>portal inquiries</small></div>
</div>
<p class="admin-form-note">* Analytics sessions come only from visitors who allowed analytics, while portal inquiries include every inquiry. The ratio mixes those sources and is directional only.</p>

<div class="admin-grid admin-grid-2">
  <section class="admin-panel">
    <div class="admin-section-title"><h2>Conversion funnel</h2><span class="admin-meta"><%= analytics.days === 'all' ? 'All time' : analytics.days + ' days' %></span></div>
    <% const maxFunnel = Math.max.apply(null, analytics.funnel.map(function (item) { return item.count; }).concat([1])); %>
    <div class="admin-funnel">
      <% analytics.funnel.forEach(function (item, index) { %>
      <div class="admin-funnel-row">
        <span><%= item.label %></span>
        <div><div class="admin-funnel-bar" style="width:<%= pct(item.count, maxFunnel) %>%"></div></div>
        <strong><%= item.count %></strong>
      </div>
      <% }); %>
    </div>
    <% if (analytics.empty) { %><p class="admin-form-note">No consented analytics events or portal inquiries in this period. Empty is the correct state; no data has been simulated.</p><% } %>
  </section>
  <section class="admin-panel">
    <div class="admin-section-title"><h2>Inquiries by type</h2><span class="admin-meta">Portal records</span></div>
    <% if (analytics.inquiryTypes.length) { %>
    <div class="admin-bars">
      <% const maxType = Math.max.apply(null, analytics.inquiryTypes.map(function (row) { return row.count; }).concat([1])); %>
      <% analytics.inquiryTypes.forEach(function (row) { %>
      <div class="admin-bar-row"><span><%= row.type %></span><div class="admin-bar-track"><div class="admin-bar-fill" style="width:<%= pct(row.count, maxType) %>%"></div></div><strong><%= row.count %></strong></div>
      <% }); %>
    </div>
    <% } else { %><div class="admin-empty">No inquiries recorded yet.</div><% } %>
    <h3 style="margin-top:1.2rem">Email delivery</h3>
    <div class="admin-email-status">
      <% if (!outbox.length) { %><span>No outbox entries</span><% } %>
      <% outbox.forEach(function (row) { %><span><%= row.status %>: <strong><%= row.count %></strong></span><% }); %>
    </div>
    <p class="admin-form-note"><%= emailConfigured ? 'SMTP is configured. Check the outbox for failures.' : 'SMTP is not configured. Form submissions are stored, but no email is sent.' %></p>
  </section>
</div>

<div class="admin-grid admin-grid-2">
  <section class="admin-panel">
    <div class="admin-section-title"><h2>Markets</h2></div>
    <% if (analytics.markets.length) { %>
    <div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>Market</th><th>Sessions</th><th>Page views</th><th>Submit events</th><th>Portal inquiries</th></tr></thead><tbody>
      <% analytics.markets.forEach(function (row) { %><tr><td><%= row.market %></td><td><%= row.sessions %></td><td><%= row.pageviews %></td><td><%= row.submits %></td><td><%= row.inquiries %></td></tr><% }); %>
    </tbody></table></div>
    <% } else { %><div class="admin-empty">No market analytics yet.</div><% } %>
  </section>
  <section class="admin-panel">
    <div class="admin-section-title"><h2>Top products</h2></div>
    <% if (analytics.topProducts.length) { %>
    <div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>SKU</th><th>Views</th><th>List adds</th><th>Submit events</th></tr></thead><tbody>
      <% analytics.topProducts.forEach(function (row) { %><tr><td><%= row.product_sku %></td><td><%= row.views %></td><td><%= row.adds %></td><td><%= row.submits %></td></tr><% }); %>
    </tbody></table></div>
    <% } else { %><div class="admin-empty">No product analytics yet.</div><% } %>
  </section>
</div>

<div class="admin-grid admin-grid-2">
  <section class="admin-panel">
    <div class="admin-section-title"><h2>Traffic context</h2></div>
    <div class="admin-grid admin-grid-2">
      <div>
        <h3>Locale</h3>
        <% if (analytics.locales.length) { %><ul class="admin-list"><% analytics.locales.forEach(function (row) { %><li><strong><%= row.locale %></strong> · <%= row.sessions %> sessions · <%= row.submits %> submit events</li><% }); %></ul><% } else { %><p class="admin-meta">No data yet.</p><% } %>
      </div>
      <div>
        <h3>Device</h3>
        <% if (analytics.devices.length) { %><ul class="admin-list"><% analytics.devices.forEach(function (row) { %><li><strong><%= row.device %></strong> · <%= row.sessions %> sessions · <%= row.submits %> submit events</li><% }); %></ul><% } else { %><p class="admin-meta">No data yet.</p><% } %>
      </div>
    </div>
  </section>
  <section class="admin-panel">
    <div class="admin-section-title"><h2>Inquiry entry pages</h2></div>
    <% if (analytics.sourcePages.length) { %>
    <div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>Path</th><th>Form starts</th><th>Submit events</th></tr></thead><tbody>
      <% analytics.sourcePages.forEach(function (row) { %><tr><td><%= row.path %></td><td><%= row.starts %></td><td><%= row.submits %></td></tr><% }); %>
    </tbody></table></div>
    <% } else { %><div class="admin-empty">No inquiry-form starts yet.</div><% } %>
  </section>
</div>

<section class="admin-panel">
  <div class="admin-section-title"><h2>CRO signals</h2><span class="admin-meta">Action prompts, not measured uplift</span></div>
  <div class="admin-grid admin-grid-2">
    <div>
      <h3>Products with views but no submit event</h3>
      <% const weakProducts = analytics.topProducts.filter(function (row) { return row.views >= 2 && row.submits === 0; }); %>
      <% if (weakProducts.length) { %><ul class="admin-list"><% weakProducts.forEach(function (row) { %><li><strong><%= row.product_sku %></strong> — <%= row.views %> views, <%= row.adds %> list adds, 0 submit events. Review whether the page has enough confirmed data or a clear next step.</li><% }); %></ul>
      <% } else { %><p class="admin-meta">No product currently shows this pattern with enough data.</p><% } %>
    </div>
    <div>
      <h3>Markets with sessions but no submit event</h3>
      <% const weakMarkets = analytics.markets.filter(function (row) { return row.sessions >= 2 && row.submits === 0; }); %>
      <% if (weakMarkets.length) { %><ul class="admin-list"><% weakMarkets.forEach(function (row) { %><li><strong><%= row.market %></strong> — <%= row.sessions %> sessions, no form submit event. Check units, trade terms and document relevance for that edition.</li><% }); %></ul>
      <% } else { %><p class="admin-meta">No market currently shows this pattern with enough data.</p><% } %>
    </div>
  </div>
  <p class="admin-form-note">These are descriptive prompts derived from small samples, not proof of causality. Do not claim conversion improvements without a baseline and controlled measurement.</p>
</section>
<% } else { %>
<div class="admin-kpis">
  <div class="admin-kpi"><span>Products</span><strong><%= counts.products %></strong><small><%= counts.published %> published</small></div>
  <div class="admin-kpi"><span>Documents</span><strong><%= counts.documents %></strong><small><%= counts.pendingDocs %> not available</small></div>
  <div class="admin-kpi"><span>FAQs</span><strong><%= counts.faqs %></strong><small>published</small></div>
  <div class="admin-kpi"><span>Translations</span><strong><%= counts.translations %></strong><small>draft / AI draft</small></div>
  <div class="admin-kpi"><span>Inquiries</span><strong><%= counts.inquiries %></strong><small><%= counts.newInquiries %> new</small></div>
</div>
<div class="admin-note">Your role does not include consented analytics. You can still maintain content, products, FAQs and documents. The storefront uses the same database.</div>
<% } %>

<div class="admin-grid admin-grid-2">
  <section class="admin-panel">
    <div class="admin-section-title"><h2>Knowledge-base questions</h2><a class="text-link" href="/admin/content">Improve content</a></div>
    <p class="admin-form-note">Redacted questions from the public assistant. Use these to identify missing product data or FAQ content.</p>
    <% if (assistantTop.length) { %>
    <ul class="admin-list">
      <% assistantTop.forEach(function (row) { %><li><strong><%= row.question_redacted %></strong><br><span class="admin-meta"><%= row.matched_type %> · answered: <%= row.answered ? 'yes' : 'no' %> · count: <%= row.count %></span></li><% }); %>
    </ul>
    <% } else { %><div class="admin-empty">No assistant questions recorded yet.</div><% } %>
    <% if (assistantUnanswered.length) { %>
    <h3 style="margin-top:1rem">Recent unanswered questions</h3>
    <ul class="admin-list"><% assistantUnanswered.forEach(function (row) { %><li><%= row.question_redacted %> <span class="admin-meta">(<%= row.market || '—' %> · <%= row.created_at.slice(0,10) %>)</span></li><% }); %></ul>
    <% } %>
  </section>
  <section class="admin-panel">
    <div class="admin-section-title"><h2>Recent inquiries</h2><% if (canInquiries) { %><a class="text-link" href="/admin/inquiries">View all</a><% } %></div>
    <% if (ownInquiries.rows.length) { %>
    <div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>Reference</th><th>Type</th><th>Company</th><th>Status</th><th>Date</th></tr></thead><tbody>
      <% ownInquiries.rows.forEach(function (row) { %>
      <tr><td><a href="/admin/inquiries/<%= row.id %>"><%= row.reference %></a></td><td><%= row.type %></td><td><%= row.company || row.name %></td><td><span class="status-pill status-<%= row.status %>"><%= row.status %></span></td><td><%= row.created_at.slice(0,10) %></td></tr>
      <% }); %>
    </tbody></table></div>
    <% } else { %><div class="admin-empty"><%= canInquiries ? 'No inquiries recorded yet.' : 'Inquiry details are not available to this role.' %></div><% } %>
  </section>
</div>
