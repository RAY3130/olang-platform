<div class="admin-toolbar">
  <div><p class="admin-kicker">Content management</p><h2><%= pageLabel %></h2></div>
  <a class="btn btn-ghost btn-small" href="/admin/content">Back to content</a>
</div>

<section class="admin-panel">
  <form method="get" action="/admin/content/<%= pageKey %>" class="admin-form">
    <div class="admin-form-grid">
      <label>Locale<select name="locale"><option value="en"<%= locale === 'en' ? ' selected' : '' %>>English</option><option value="de"<%= locale === 'de' ? ' selected' : '' %>>Deutsch</option><option value="it"<%= locale === 'it' ? ' selected' : '' %>>Italiano</option></select></label>
      <label>Market edition<select name="market"><option value="*"<%= market === '*' ? ' selected' : '' %>>All markets (default)</option><option value="en"<%= market === 'en' ? ' selected' : '' %>>Global</option><option value="en-us"<%= market === 'en-us' ? ' selected' : '' %>>United States</option><option value="en-au"<%= market === 'en-au' ? ' selected' : '' %>>Australia</option><option value="en-gb"<%= market === 'en-gb' ? ' selected' : '' %>>United Kingdom</option><option value="de"<%= market === 'de' ? ' selected' : '' %>>Deutschland</option><option value="it"<%= market === 'it' ? ' selected' : '' %>>Italia</option></select></label>
    </div>
    <button class="btn btn-ghost btn-small" type="submit">Load fields</button>
  </form>
</section>

<form method="post" action="/admin/content/<%= pageKey %>" class="admin-form">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <input type="hidden" name="locale" value="<%= locale %>">
  <input type="hidden" name="market" value="<%= market %>">
  <% fields.forEach(function (field) { %>
  <section class="admin-panel">
    <label><span><%= field.label %> <span class="admin-meta"><%= field.key %></span></span>
      <% if (field.type === 'textarea') { %>
      <textarea name="field_<%= field.key %>" rows="4" maxlength="4000" placeholder="Default: <%= field.defaultValue %>"><%= field.override %></textarea>
      <% } else { %>
      <input name="field_<%= field.key %>" value="<%= field.override %>" maxlength="300" placeholder="Default: <%= field.defaultValue %>">
      <% } %>
    </label>
    <p class="admin-form-note">Default (<%= locale %>): <%= field.defaultValue %></p>
  </section>
  <% }); %>
  <div class="admin-form-actions">
    <button class="btn btn-primary" type="submit">Save content overrides</button>
    <a class="btn btn-ghost" href="/admin/content">Cancel</a>
  </div>
</form>
<p class="admin-form-note">Leave a field empty to remove the override. Overrides are plain text; HTML is not accepted.</p>
