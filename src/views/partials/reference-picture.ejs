<% if (image) { %>
<% const priorityImage = typeof priority !== 'undefined' && priority; %>
<% const eagerImage = priorityImage || (typeof eager !== 'undefined' && eager); %>
<picture class="reference-picture">
  <source type="image/webp" srcset="<%= image.webp %>">
  <img src="<%= image.src %>" alt="<%= image.alt %>" width="<%= image.width %>" height="<%= image.height %>" loading="<%= eagerImage ? 'eager' : 'lazy' %>" fetchpriority="<%= priorityImage ? 'high' : 'auto' %>" decoding="async">
</picture>
<% } %>
