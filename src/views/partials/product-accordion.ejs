<%
  const grouped = {
    specs: ['material', 'dimensions', 'weight', 'finish'],
    install: ['installation', 'application'],
    packing: ['packaging', 'moq', 'lead_time'],
    docs: ['certification', 'technical_documents', 'oem_capability']
  };
  const rowByKey = {};
  specRows.forEach(function (row) { rowByKey[row.key] = row; });
  function rowsFor(keys) { return keys.map(function (key) { return rowByKey[key]; }).filter(Boolean); }
  // Measurements print the millimetre source first so the same string appears on the card, in
  // the meta description and in the structured data; the inch rendition follows in brackets.
  function cellText(entry) {
    if (entry.value) {
      if (entry.convertible && entry.metric && entry.imperial && entry.metric !== entry.imperial) {
        return entry.metric + ' (' + entry.imperial + ')';
      }
      return entry.value;
    }
    return t('status.' + (entry.status || 'available_on_request'));
  }
  function rowText(row) {
    return row.values.map(cellText).join(' · ');
  }
%>
<div class="product-accordions">
  <details class="product-accordion" open>
    <summary><span><%= t('product.accordionSpecs') %></span></summary>
    <div class="accordion-body">
      <dl class="accordion-spec-list">
        <% rowsFor(grouped.specs).forEach(function (row) { %>
        <div data-spec-field="<%= row.key %>" data-status="<%= row.status %>">
          <dt><%= t(row.labelKey) %></dt>
          <dd><%= rowText(row) %></dd>
        </div>
        <% }); %>
      </dl>
    </div>
  </details>
  <details class="product-accordion">
    <summary><span><%= t('product.accordionInstall') %></span></summary>
    <div class="accordion-body">
      <dl class="accordion-spec-list">
        <% rowsFor(grouped.install).forEach(function (row) { %>
        <div data-spec-field="<%= row.key %>" data-status="<%= row.status %>"><dt><%= t(row.labelKey) %></dt><dd><%= rowText(row) %></dd></div>
        <% }); %>
      </dl>
      <p class="small-note"><%= t('product.installNote') %></p>
    </div>
  </details>
  <details class="product-accordion">
    <summary><span><%= t('product.accordionPacking') %></span></summary>
    <div class="accordion-body">
      <dl class="accordion-spec-list">
        <% rowsFor(grouped.packing).forEach(function (row) { %>
        <div data-spec-field="<%= row.key %>" data-status="<%= row.status %>"><dt><%= t(row.labelKey) %></dt><dd><%= rowText(row) %></dd></div>
        <% }); %>
      </dl>
    </div>
  </details>
  <details class="product-accordion">
    <summary><span><%= t('product.accordionDocs') %></span></summary>
    <div class="accordion-body">
      <dl class="accordion-spec-list">
        <% rowsFor(grouped.docs).forEach(function (row) { %>
        <div data-spec-field="<%= row.key %>" data-status="<%= row.status %>"><dt><%= t(row.labelKey) %></dt><dd><%= rowText(row) %></dd></div>
        <% }); %>
      </dl>
      <p class="small-note"><%= t('product.docsNote') %></p>
      <p class="small-note"><a class="text-link" href="<%= urlFor('resources') %>?product=<%= encodeURIComponent(product.sku) %>#document-request"><%= copy.requestDocument %> →</a></p>
    </div>
  </details>
</div>
