<aside class="cookie-banner" id="cookie-banner" aria-labelledby="cookie-title" data-cookie-banner>
  <div class="cookie-banner-inner">
    <div>
      <h2 id="cookie-title"><%= t('cookies.title') %></h2>
      <p><%= t('cookies.text') %></p>
    </div>
    <div class="cookie-actions">
      <form method="post" action="/api/consent" data-consent-form>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="market" value="<%= market.code %>">
        <input type="hidden" name="return_to" value="<%= currentPath %>">
        <button type="submit" name="analytics" value="1" class="btn btn-primary"><%= t('cookies.accept') %></button>
        <button type="submit" name="analytics" value="0" class="btn btn-ghost"><%= t('cookies.reject') %></button>
        <a class="text-link" href="<%= urlFor('privacy') %>#cookies"><%= t('cookies.settings') %></a>
      </form>
    </div>
  </div>
</aside>
