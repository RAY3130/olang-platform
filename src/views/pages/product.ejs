<link rel="preload" as="image" type="image/webp" href="/images/products/official/responsive/<%= product.sku %>-1600.webp" imagesrcset="/images/products/official/responsive/<%= product.sku %>-1600.webp 1600w, /images/products/official/responsive/<%= product.sku %>-800.webp 800w" imagesizes="(max-width: 767px) 92vw, 58vw">
<%
  const seriesText = localizedSeries(product.series, locale);
  const seriesHref = product.series ? urlFor('series/' + seriesSlug(product.series)) : '';
  const materialAttr = product.attrMap.material || null;
  const dimensionsAttr = product.attrMap.dimensions || null;
  const installationAttr = product.attrMap.installation || null;
  const dimensionsSpec = dimensionsAttr && dimensionsAttr.value ? specValue(dimensionsAttr, 'dimensions') : null;
  const dimensionsValue = dimensionsSpec ? (dimensionsSpec.text || dimensionsAttr.value) : '';
  const dimensionsMetric = dimensionsSpec ? (dimensionsSpec.metric || dimensionsAttr.value) : '';
  const finishText = (product.colors && product.colors.length)
    ? product.colors.map(function (c) { return c.localized_label || c.display_label; }).join(' · ')
    : '';
  const finishCount = (product.colors && product.colors.length) || (product.finishes && product.finishes.length) || 0;
  const productUseText = productUse(product.category_key);
%>
<section class="product-detail">
  <div class="wrap">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <% breadcrumbs.forEach(function (crumb, index) { %>
      <% if (index < breadcrumbs.length - 1) { %><a href="<%= crumb.url %>"><%= crumb.name %></a><span aria-hidden="true">/</span><% } else { %><span aria-current="page"><%= crumb.name %></span><% } %>
      <% }); %>
    </nav>
    <div class="product-detail-grid">
      <%- include('../partials/product-media-tabs') %>
      <div class="product-detail-copy">
        <div class="product-summary">
        <p class="eyebrow"><%= product.category_name %><%= seriesText ? ' · ' : '' %><% if (seriesHref) { %><a class="inline-link" href="<%= seriesHref %>"><%= seriesText %></a><% } else { %><%= seriesText %><% } %></p>
        <h1><%= product.name %> <span class="product-h1-model"><%= product.sku %></span></h1>
        <p class="product-use"><%= typeof productIntro !== 'undefined' && productIntro ? productIntro : productUseText %></p>
        <div class="product-chips">
          <div><span class="chip-label"><%= t('proc.baseMaterial') %></span><strong><%= materialDisplay || t('status.' + ((materialAttr && materialAttr.status) || 'pending_verification')) %></strong></div>
          <div class="chip-dimensions"><span class="chip-label"><%= t('proc.dimensions') %></span><strong data-metric="<%= dimensionsMetric %>"><%= dimensionsValue || t('status.available_on_request') %></strong><% if (dimensionsValue) { %><button type="button" class="chip-unit" data-unit-toggle data-unit-current="<%= market.unitSystem %>" aria-label="<%= t('common.unitMm') %> / <%= t('common.unitInch') %>"><%= market.unitSystem === 'imperial' ? t('common.unitInch') : t('common.unitMm') %> ↔</button><% } else { %><a class="chip-request" href="#quote"><%= pc.requestDimensions %> →</a><% } %></div>
          <div><span class="chip-label"><%= t('proc.surfaceFinish') %></span><strong><%= finishText || t('status.available_on_request') %></strong></div>
          <div><span class="chip-label"><%= t('proc.installation') %></span><strong><%= installationAttr && installationAttr.value ? installationAttr.value : t('status.available_on_request') %></strong></div>
        </div>
        <div class="product-model-line">
          <span><strong><%= product.sku %></strong></span>
          <% if (product.series) { %><span><a class="inline-link" href="<%= seriesHref %>"><%= seriesText %></a></span><% } %>
          <span><%= pc.finishCount.replace('{count}', finishCount) %></span>
        </div>
        <div class="product-actions product-actions-primary">
          <a class="btn btn-primary" href="#quote"><%= pc.requestQuote %></a>
          <a class="btn btn-ghost" href="<%= urlFor('customization') %>?sku=<%= encodeURIComponent(product.sku) %>" data-product-customizer><%= pc.customizeModel %></a>
          <button type="button" class="btn btn-ghost" data-add-inquiry
            data-sku="<%= product.sku %>"
            data-name="<%= product.name %>"
            data-url="<%= urlFor('products/' + product.slug) %>"
            data-image="<%= product.image_path ? '/' + product.image_path.replace(/^\/+/, '') : '' %>"
            data-category="<%= product.category_name %>"><%= pc.addToList %></button>
          <button type="button" class="btn btn-text" data-open-assistant><%= pc.askAbout %></button>
        </div>
        </div>
        <div class="product-body">
        <div class="product-value-grid">
          <div class="product-value-card">
            <span class="value-kicker"><%= pc.customizeTitle %></span>
            <p><%= pc.customizeText %></p>
            <a class="text-link" href="<%= urlFor('customization') %>?sku=<%= encodeURIComponent(product.sku) %>"><%= pc.customizeModel %> →</a>
          </div>
          <div class="product-value-card">
            <span class="value-kicker"><%= pc.technicalTitle %></span>
            <p><%= pc.technicalText %></p>
            <a class="text-link" href="#documents"><%= pc.requestDocuments %> →</a>
          </div>
        </div>
        <p class="product-quote-note"><%= pc.priceNote %></p>
        <p class="trust-line"><span><%= t('product.trustReference') %></span><span><%= t('product.trustLead') %></span><span><%= t('product.trustSample') %></span></p>
        <%- include('../partials/product-accordion') %>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="section section-tight product-record-section">
  <div class="wrap product-record-grid">
    <div>
      <p class="eyebrow"><%= pc.specTitle %></p>
      <h2><%= product.name %> · <%= product.sku %></h2>
      <p><%= productUseText %></p>
      <p class="small-note"><%= pc.specIntro %></p>
    </div>
    <aside class="customer-spec-card" aria-label="<%= pc.specTitle %>">
      <h2><%= pc.specTitle %></h2>
      <dl>
        <div><dt><%= pc.specDimensions %></dt><dd><%= dimensionsValue || pc.specDimensionsText %></dd></div>
        <div><dt><%= pc.specMaterial %></dt><dd><%= materialDisplay || pc.specMaterialText %></dd></div>
        <div><dt><%= pc.specPacking %></dt><dd><%= (product.attrMap.packaging && product.attrMap.packaging.value) || pc.specPackingText %></dd></div>
      </dl>
      <a class="btn btn-ghost" href="#quote"><%= pc.requestThese %></a>
      <a class="text-link" href="#documents"><%= pc.documentsLink %> →</a>
    </aside>
  </div>
</section>

<section class="section section-soft" id="documents">
  <div class="wrap">
    <div class="section-head split-head">
      <div>
        <p class="eyebrow"><%= pc.technicalTitle %></p>
        <h2><%= pc.documentsTitle %></h2>
        <p class="section-lede"><%= pc.documentsText %></p>
      </div>
      <a class="btn btn-ghost" href="<%= urlFor('resources') %>?product=<%= encodeURIComponent(product.sku) %>"><%= pc.requestDocuments %></a>
    </div>
    <% if (documents && documents.length) { %>
    <div class="document-table-wrap">
      <table class="document-table">
        <thead><tr><th><%= pc.matrixType %></th><th><%= pc.docLanguage %></th><th><%= pc.docVersion %></th><th><%= pc.docMarket %></th><th><%= pc.docStatus %></th><th></th></tr></thead>
        <tbody>
          <% documents.forEach(function (doc) { %>
          <tr>
            <td><strong><%= documentTypeLabel(doc.doc_type) %></strong><br><small><%= product.sku %> · <%= documentTypeLabel(doc.doc_type) %></small></td>
            <td><%= languageName(String(doc.language || 'en').toLowerCase()) %></td>
            <td><%= doc.version === 'Not published' ? pc.notPublished : doc.version %></td>
            <td><%= doc.markets.map(function (code) { return (markets[code] && markets[code].short) || (code === 'global' ? t('common.allMarkets') : code); }).join(', ') %></td>
            <td><span class="status <%= doc.hasFile ? 'status-verified' : 'status-available_on_request' %>"><%= doc.hasFile ? pc.docAvailable : pc.docOnRequest %></span></td>
            <td>
              <% if (doc.hasFile) { %>
              <a class="btn btn-ghost btn-small" href="/documents/<%= doc.id %>/download"><%= pc.downloadFile %> ↓</a>
              <% } else { %>
              <a class="btn btn-ghost btn-small" href="<%= urlFor('resources') %>?product=<%= encodeURIComponent(product.sku) %>&type=<%= encodeURIComponent(doc.doc_type) %>#document-request"><%= pc.docRequest %></a>
              <% } %>
            </td>
          </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
    <% } else { %>
    <div class="empty-state"><h3><%= pc.documentsEmpty %></h3><a class="btn btn-primary" href="<%= urlFor('resources') %>?product=<%= encodeURIComponent(product.sku) %>#document-request"><%= pc.requestDocuments %></a></div>
    <% } %>
  </div>
</section>

<% if (seriesSiblings && seriesSiblings.length > 1) { %>
<section class="section section-tight" id="series-matrix">
  <div class="wrap">
    <div class="section-head split-head">
      <div><p class="eyebrow"><%= pc.seriesTitle %></p><h2><%= pc.matrixTitle %></h2><p class="section-lede"><%= pc.matrixText %></p></div>
      <% if (seriesHref) { %><a class="btn btn-ghost" href="<%= seriesHref %>"><%= pc.seriesExplore %> →</a><% } %>
    </div>
    <details class="sku-matrix"<%= seriesSiblings.length <= 10 ? ' open' : '' %>>
      <summary><%= pc.matrixTitle %> · <%= seriesSiblings.length %> <%= pc.seriesModels %></summary>
      <div class="matrix-scroll">
        <table>
          <thead><tr><th><%= pc.matrixModel %></th><th><%= pc.matrixType %></th><th><%= pc.matrixDimensions %></th><th><%= pc.matrixFinish %></th><th><%= t('proc.moq') %></th></tr></thead>
          <tbody>
            <% seriesSiblings.forEach(function (sib) { %>
            <tr<%= sib.sku === product.sku ? ' class="is-current"' : '' %>>
              <td><a href="<%= urlFor('products/' + sib.slug) %>"><strong><%= sib.sku %></strong><br><span><%= sib.name %></span></a></td>
              <td><%= sib.category_name %></td>
              <td><%= sib.matrix_dimensions || pc.matrixDimensions %></td>
              <td><%= sib.matrix_finish || pc.matrixFinish %></td>
              <td><%= sib.matrix_moq || '—' %></td>
            </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </details>
  </div>
</section>
<% } %>

<% if (referenceDetail || referenceInstall) { %>
<section class="section section-tight product-reference-section">
  <div class="wrap product-reference-grid">
    <div class="product-reference-head">
      <p class="eyebrow"><%= pc.refDetailCaption %></p>
      <h2><%= pc.refDetailCaption %></h2>
      <p><%= productUseText %></p>
    </div>
    <% [referenceDetail, referenceInstall].filter(Boolean).forEach(function (image) { %>
    <figure>
      <%- include('../partials/reference-picture', { image: image }) %>
      <figcaption><%= pc.refDetailCaption %></figcaption>
    </figure>
    <% }); %>
  </div>
</section>
<% } %>

<section class="section section-tight install-care-section">
  <div class="wrap install-care-grid">
    <div>
      <p class="eyebrow"><%= pc.installTitle %></p>
      <h2><%= pc.installTitle %></h2>
      <p><%= pc.installText %></p>
      <a class="text-link" href="#documents"><%= pc.requestDocuments %> →</a>
      <div class="video-placeholder"><span>VIDEO</span><p><%= pc.videoPlaceholder %></p></div>
    </div>
    <div>
      <p class="eyebrow"><%= pc.careTitle %></p>
      <h2><%= pc.careTitle %></h2>
      <p><%= pc.careText %></p>
      <a class="text-link" href="<%= urlFor('resources') %>?product=<%= encodeURIComponent(product.sku) %>"><%= pc.requestDocuments %> →</a>
    </div>
  </div>
</section>

<section class="section section-soft" id="quote">
  <div class="wrap form-layout">
    <div>
      <p class="eyebrow"><%= copy.quoteTitle %></p>
      <h2><%= pc.quoteFor.replace('{sku}', product.sku) %></h2>
      <p class="lede"><%= copy.priceNotice %></p>
      <div class="note-card accent-card">
        <p class="eyebrow"><%= copy.materialTitle %></p>
        <h3><%= copy.materialTitle %></h3>
        <p><%= copy.materialText %></p>
      </div>
      <div class="path-mini">
        <a href="<%= urlFor('customization') %>?sku=<%= encodeURIComponent(product.sku) %>"><%= t('common.startOem') %></a>
        <a href="<%= urlFor('resources') %>?product=<%= encodeURIComponent(product.sku) %>"><%= pc.requestDocuments %></a>
      </div>
    </div>
    <%- include('../partials/inquiry-form', { formType: 'product_info', product: product, prefill: {} }) %>
  </div>
</section>



<section class="section">
  <div class="wrap">
    <div class="section-head split-head">
      <div><p class="eyebrow"><%= copy.relatedTitle %></p><h2><%= copy.relatedTitle %></h2><p class="section-lede"><%= copy.relatedText %></p></div>
      <a class="btn btn-ghost" href="<%= urlFor('products') %>"><%= t('common.browseProducts') %></a>
    </div>
    <div class="product-grid">
      <% related.forEach(function (item) { %>
      <%- include('../partials/product-card', { product: item }) %>
      <% }); %>
    </div>
  </div>
</section>

<script src="/assets/media-gallery.js" defer></script>

<div class="compare-bar" data-compare-bar hidden>
  <span><strong data-compare-count>0</strong> <%= t('common.selected') %></span>
  <a class="btn btn-primary" href="<%= urlFor('compare') %>" data-compare-link><%= t('common.compareSelected') %></a>
  <button type="button" class="link-button" data-compare-clear><%= t('common.clear') %></button>
</div>
