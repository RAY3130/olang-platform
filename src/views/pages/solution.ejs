<section class="page-hero">
  <div class="wrap page-hero-grid">
    <div>
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <% breadcrumbs.forEach(function (crumb, index) { %>
        <% if (index < breadcrumbs.length - 1) { %><a href="<%= crumb.url %>"><%= crumb.name %></a><span aria-hidden="true">/</span><% } else { %><span aria-current="page"><%= crumb.name %></span><% } %>
        <% }); %>
      </nav>
      <p class="eyebrow"><%= copy.detailKicker %> · <%= item.code %></p>
      <h1><%= item.title %></h1>
      <p class="lede"><%= item.intro %></p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="<%= routeUrl %>"><%= item.cta %></a>
        <a class="btn btn-ghost" href="<%= urlFor('products') %>"><%= t('common.browseProducts') %></a>
      </div>
    </div>
    <div class="page-hero-media">
      <% if (products[0] && products[0].image_path) { %>
      <img src="/<%= products[0].image_path.replace(/^\/+/, '') %>" alt="<%= products[0].name %>" width="900" height="900">
      <% } %>
    </div>
  </div>
</section>

<section class="section">
  <div class="wrap detail-two-col">
    <div>
      <p class="eyebrow"><%= copy.requirementsTitle %></p>
      <h2><%= copy.requirementsTitle %></h2>
      <ul class="clean-list">
        <% item.needs.forEach(function (need) { %><li><%= need %></li><% }); %>
      </ul>
      <div class="notice-box"><%= copy.routeText %></div>
    </div>
    <div>
      <p class="eyebrow"><%= copy.productsTitle %></p>
      <h2><%= copy.productsTitle %></h2>
      <div class="tag-row">
        <% categories.forEach(function (cat) { %><a class="tag" href="<%= urlFor('products') %>?category=<%= encodeURIComponent(cat.slug) %>"><%= cat.name %> (<%= cat.product_count %>)</a><% }); %>
      </div>
      <p class="small-note"><%= copy.documentsText %></p>
      <a class="text-link" href="<%= urlFor('resources') %>"><%= copy.documentsTitle %> →</a>
    </div>
  </div>
</section>

<section class="section section-soft">
  <div class="wrap">
    <div class="section-head"><p class="eyebrow"><%= copy.productsTitle %></p><h2><%= item.title %></h2></div>
    <% if (products.length) { %>
    <div class="product-grid">
      <% products.forEach(function (product) { %>
      <%- include('../partials/product-card', { product: product }) %>
      <% }); %>
    </div>
    <% } else { %>
    <div class="empty-state"><p><%= t('pages.products.noResultsHelp') %></p></div>
    <% } %>
    <p class="small-note"><%= copy.noCaseClaim %></p>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <div class="section-head"><p class="eyebrow"><%= copy.relatedTitle %></p><h2><%= copy.relatedTitle %></h2></div>
    <div class="related-links">
      <% related.forEach(function (entry) { %><a href="<%= entry.href %>"><strong><%= entry.title %></strong><span><%= entry.summary %></span></a><% }); %>
    </div>
  </div>
</section>
