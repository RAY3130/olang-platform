<section class="page-hero">
  <div class="wrap page-hero-grid">
    <div>
      <p class="eyebrow"><%= copy.kicker %></p>
      <h1><%= copy.title %></h1>
      <p class="lede"><%= copy.lede %></p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="#inquiry-form"><%= copy.cta %></a>
        <a class="btn btn-ghost" href="<%= urlFor('products') %>"><%= t('common.browseProducts') %></a>
      </div>
    </div>
    <div class="page-hero-media">
      <img src="/images/products/double-towel-bar-ol-1209.jpg" alt="OL-1209 <%= t('common.product') %>" width="900" height="900">
    </div>
  </div>
</section>


<section class="section">
  <div class="wrap split">
    <div>
      <p class="eyebrow"><%= copy.whoKicker %></p>
      <h2><%= copy.whoTitle %></h2>
      <p class="lede"><%= copy.whoText %></p>
      <ul class="clean-list">
        <% copy.whoPoints.forEach(function (point) { %><li><%= point %></li><% }); %>
      </ul>
    </div>
    <div class="note-card accent-card">
      <p class="eyebrow"><%= copy.noteTitle %></p>
      <h3><%= t('common.dataStatus') %></h3>
      <p><%= copy.noteText %></p>
      <a class="text-link" href="<%= urlFor('products') %>"><%= t('common.viewAll') %> →</a>
    </div>
  </div>
</section>

<section class="section section-soft">
  <div class="wrap">
    <div class="section-head"><p class="eyebrow"><%= copy.processKicker %></p><h2><%= copy.processTitle %></h2></div>
    <div class="process-grid process-grid-6">
      <% copy.process.forEach(function (step) { %>
      <div><span><%= step.number %></span><h3><%= step.title %></h3><p><%= step.text %></p></div>
      <% }); %>
    </div>
  </div>
</section>

<section class="section">
  <div class="wrap split">
    <div>
      <p class="eyebrow"><%= copy.sendKicker %></p>
      <h2><%= copy.sendTitle %></h2>
      <ul class="clean-list">
        <% copy.sendPoints.forEach(function (point) { %><li><%= point %></li><% }); %>
      </ul>
    </div>
    <div class="page-hero-media">
      <img src="/images/products/robe-hook-ol-1204.jpg" alt="OL-1204 <%= t('common.product') %>" width="900" height="900" loading="lazy">
      <p class="media-caption"><%= t('common.publicSource') %> · OLANG reference</p>
    </div>
  </div>
</section>

<section class="section section-soft" id="wholesale-inquiry">
  <div class="wrap form-layout">
    <div>
      <p class="eyebrow"><%= copy.formKicker %></p>
      <h2><%= copy.formTitle %></h2>
      <p class="lede"><%= copy.formText %></p>
      <p class="small-note"><%= copy.noteText %></p>
      <div class="path-mini">
        <a href="<%= urlFor('inquiry') %>"><%= t('common.inquiryList') %></a>
        <a href="<%= urlFor('oem') %>"><%= t('footer.oem') %></a>
      </div>
    </div>
    <%- include('../partials/inquiry-form', { formType: 'wholesale', pickerProducts: products, prefill: {} }) %>
  </div>
</section>

<section class="section" id="project-inquiry">
  <div class="wrap form-layout">
    <div>
      <p class="eyebrow"><%= t('pages.projects.formKicker') %></p>
      <h2><%= t('pages.projects.formTitle') %></h2>
      <p class="lede"><%= t('pages.projects.formText') %></p>
      <p class="small-note"><%= t('pages.projects.boqText') %></p>
      <div class="path-mini">
        <a href="<%= urlFor('projects') %>"><%= t('footer.projects') %></a>
        <a href="<%= urlFor('resources') %>"><%= t('common.requestDocuments') %></a>
      </div>
    </div>
    <%- include('../partials/inquiry-form', { formType: 'project', pickerProducts: products, prefill: {}, formId: 'project-inquiry-form' }) %>
  </div>
</section>

