<section class="page-hero">
  <div class="wrap narrow">
    <p class="eyebrow"><%= copy.kicker %></p>
    <h1><%= copy.title %></h1>
    <p class="lede"><%= copy.lede %></p>
    <div class="hero-actions">
      <a class="btn btn-primary" href="#inquiry-form"><%= copy.continue %></a>
      <a class="btn btn-ghost" href="<%= urlFor('products') %>"><%= t('common.browseProducts') %></a>
    </div>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <div class="inquiry-summary" data-inquiry-summary>
      <div class="section-head"><p class="eyebrow"><%= t('common.inquiryList') %></p><h2><%= t('common.inquiryList') %></h2></div>
      <p data-inquiry-empty><%= copy.empty %> <%= copy.emptyHelp %></p>
      <div data-inquiry-items></div>
      <div class="hero-actions" data-inquiry-controls hidden>
        <button class="btn btn-ghost" type="button" data-inquiry-clear><%= copy.clearList %></button>
      </div>
      <p class="small-note"><%= copy.browserNote %></p>
    </div>
  </div>
</section>

<section class="section section-soft" id="inquiry-form-section">
  <div class="wrap form-layout">
    <div>
      <p class="eyebrow"><%= copy.kicker %></p>
      <h2><%= copy.formTitle %></h2>
      <p class="lede"><%= copy.formText %></p>
      <div class="notice-box"><%= copy.maxItems %></div>
    </div>
    <%- include('../partials/inquiry-form', { formType: 'wholesale', pickerProducts: products, prefill: prefill || {} }) %>
  </div>
</section>
