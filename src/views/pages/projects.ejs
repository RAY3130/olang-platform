<section class="page-hero">
  <div class="wrap page-hero-grid">
    <div>
      <p class="eyebrow"><%= copy.kicker %></p>
      <h1><%= copy.title %></h1>
      <p class="lede"><%= copy.lede %></p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="<%= urlFor('wholesale') %>#project-inquiry"><%= copy.submit %></a>
        <a class="btn btn-ghost" href="<%= urlFor('resources') %>"><%= t('common.requestDocuments') %></a>
      </div>
    </div>
    <div class="page-hero-media">
      <img src="/images/projects/case-1.jpg" alt="Hotel project reference published by OLANG" width="1400" height="933">
      <p class="media-caption"><%= t('common.publicSource') %> · OLANG project portfolio</p>
    </div>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <div class="section-head split-head">
      <div>
        <p class="eyebrow"><%= copy.referenceKicker %></p>
        <h2><%= copy.referenceTitle %></h2>
        <p class="section-lede"><%= copy.referenceText %></p>
      </div>
      <div class="reference-badge"><span><%= cases.length %></span><small><%= copy.referenceCountLabel %></small></div>
    </div>
    <% if (cases.length) { %>
    <div class="project-grid">
      <% cases.forEach(function (entry) { %>
      <article class="project-card" id="<%= entry.slug %>">
        <a class="project-media project-card-link" href="<%= entry.href %>" aria-label="<%= entry.title %> — <%= copy.detailTitle || 'project detail' %>">
          <% if (entry.image_path) { %><img src="/<%= entry.image_path.replace(/^\/+/, '') %>" alt="<%= entry.title %> — <%= copy.publishedBuilding || 'project building' %>" width="1200" height="800" loading="lazy"><% } %>
          <span class="project-card-badge"><%= copy.detailTitle || 'Project detail' %> →</span>
        </a>
        <div class="project-body">
          <div class="project-meta">
            <span><%= entry.project_type || 'Hotel' %></span>
            <span><%= entry.location || copy.locationOnRequest %></span>
          </div>
          <h3><a href="<%= entry.href %>"><%= entry.title %></a></h3>
          <p><%= entry.localizedSummary %></p>
          <div class="tag-row">
            <span class="tag"><%= entry.verification_status === 'verified' ? copy.verifiedReference : copy.companyPublished %></span>
            <span class="tag"><%= copy.productScopePending %></span>
          </div>
          <a class="text-link" href="<%= entry.href %>"><%= copy.detailTitle || 'View project' %> →</a>
        </div>
      </article>
      <% }); %>
    </div>
    <p class="source-note"><%= copy.referenceNote %></p>
    <p class="small-note"><%= t('common.projectIllustrative') %></p>
    <% } else { %>
    <div class="empty-state"><p><%= copy.referenceEmpty %></p></div>
    <% } %>
  </div>
</section>

<section class="section section-soft">
  <div class="wrap">
    <div class="section-head"><p class="eyebrow"><%= copy.processKicker %></p><h2><%= copy.processTitle %></h2></div>
    <div class="process-grid process-grid-6">
      <% copy.process.forEach(function (step) { %><div><span><%= step.number %></span><h3><%= step.title %></h3><p><%= step.text %></p></div><% }); %>
    </div>
  </div>
</section>

<section class="section">
  <div class="wrap split">
    <div>
      <p class="eyebrow"><%= copy.supportKicker %></p>
      <h2><%= copy.supportTitle %></h2>
      <ul class="clean-list">
        <% copy.supportPoints.forEach(function (point) { %><li><%= point %></li><% }); %>
      </ul>
    </div>
    <div class="note-card">
      <p class="eyebrow"><%= copy.boqTitle %></p>
      <h3><%= copy.boqTitle %></h3>
      <p><%= copy.boqText %></p>
      <div class="tag-row"><span class="tag"><%= t('common.onRequest') %></span><span class="tag"><%= t('common.requestDocuments') %></span></div>
    </div>
  </div>
</section>

<section class="section section-soft">
  <div class="wrap narrow">
    <p class="eyebrow"><%= copy.formKicker %></p>
    <h2><%= copy.formTitle %></h2>
    <p class="lede"><%= copy.formText %></p>
    <div class="notice-box"><%= copy.formNotice %></div>
    <p><a class="btn btn-primary" href="<%= urlFor('wholesale') %>#project-inquiry"><%= copy.submit %></a></p>
  </div>
</section>
