<section class="page-hero project-detail-hero">
  <div class="wrap">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <% breadcrumbs.forEach(function (crumb, index) { %><% if (index < breadcrumbs.length - 1) { %><a href="<%= crumb.url %>"><%= crumb.name %></a><span aria-hidden="true">/</span><% } else { %><span aria-current="page"><%= crumb.name %></span><% } %><% }); %>
    </nav>
    <div class="page-hero-grid">
      <div>
        <p class="eyebrow"><%= projectCopy.detailTitle %></p>
        <h1><%= entry.title %></h1>
        <p class="lede"><%= entry.localizedSummary %></p>
        <dl class="project-facts">
          <div><dt><%= projectCopy.projectType %></dt><dd><%= entry.project_type || 'Hotel' %></dd></div>
          <div><dt><%= projectCopy.location %></dt><dd><%= entry.location || copy.locationOnRequest %></dd></div>
          <div><dt><%= projectCopy.source %></dt><dd><a class="text-link" href="<%= entry.source_url %>" target="_blank" rel="noopener noreferrer"><%= t('common.companyReported') %> ↗</a></dd></div>
        </dl>
        <div class="hero-actions">
          <a class="btn btn-primary" href="<%= urlFor('customization') %>?project=<%= encodeURIComponent(entry.slug) %>"><%= projectCopy.requestProject %></a>
          <a class="btn btn-ghost" href="<%= urlFor('projects') %>"><%= projectCopy.backToProjects %></a>
        </div>
      </div>
      <figure class="project-hero-media">
        <% if (entry.image_path) { %><img src="/<%= entry.image_path.replace(/^\/+/, '') %>" alt="<%= entry.title %> — <%= projectCopy.publishedBuilding %>" width="1200" height="900"><% } %>
        <figcaption class="media-caption"><%= projectCopy.publishedBuilding %> · OLANG</figcaption>
      </figure>
    </div>
  </div>
</section>

<section class="section section-tight">
  <div class="wrap">
    <div class="project-evidence-grid">
      <div>
        <p class="eyebrow"><%= projectCopy.verifiedFacts %></p>
        <h2><%= projectCopy.interiorGap %></h2>
        <p><%= entry.localizedDescription %></p>
        <div class="tag-row">
          <span class="tag"><%= entry.verification_status === 'verified' ? copy.verifiedReference : t('common.companyReported') %></span>
          <span class="tag"><%= projectCopy.productScopePending %></span>
        </div>
      </div>
      <aside class="gap-card">
        <p class="eyebrow"><%= projectCopy.interiorGap %></p>
        <h2><%= projectCopy.interiorGap %></h2>
        <p><%= projectCopy.interiorGapText %></p>
        <p><a class="text-link" href="<%= urlFor('customization') %>"><%= projectCopy.requestProject %> →</a></p>
      </aside>
    </div>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <div class="section-head split-head">
      <div><p class="eyebrow"><%= projectCopy.relatedRange %></p><h2><%= projectCopy.relatedRange %></h2><p class="section-lede"><%= projectCopy.relatedRangeText %></p></div>
      <a class="btn btn-ghost" href="<%= urlFor('products') %>"><%= t('common.browseProducts') %></a>
    </div>
    <div class="product-grid">
      <% candidateProducts.forEach(function (product) { %>
      <%- include('../partials/product-card', { product: product }) %>
      <% }); %>
    </div>
    <div class="project-docs">
      <h2><%= projectCopy.docsTitle %></h2>
      <p><%= projectCopy.docsText %></p>
      <a class="btn btn-primary" href="<%= urlFor('customization') %>?project=<%= encodeURIComponent(entry.slug) %>"><%= projectCopy.requestProject %></a>
    </div>
    <p class="source-note"><%= copy.referenceNote %> <a href="<%= entry.source_url %>" target="_blank" rel="noopener noreferrer"><%= t('common.viewSource') %> ↗</a></p>
  </div>
</section>
